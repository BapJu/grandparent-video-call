NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# JaaS (8x8 Jitsi as a Service). AppID also exposed to the client to build URLs.
JAAS_APP_ID=vpaas-magic-cookie-<...>
NEXT_PUBLIC_JAAS_APP_ID=vpaas-magic-cookie-<...>
JAAS_KID=vpaas-magic-cookie-<...>/<key-id>
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
