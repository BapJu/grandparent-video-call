SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_DEVICE_EMAIL=<pi-device-account-email>
SUPABASE_DEVICE_PASSWORD=<pi-device-account-password>
SUPABASE_CHANNEL=visio-tv-calls
MAX_CALL_DURATION_SECONDS=5400
FIREFOX_BIN=/usr/bin/firefox
FIREFOX_PROFILE_DIR=/home/julienne/.config/visio-tv-ff

# Web app /kiosk page — embeds the JaaS meeting; the Pi joins as moderator so
# the room starts on its own (no host login). Required.
KIOSK_URL=https://<your-app>.vercel.app/kiosk

# Hang up this long after the last remote participant leaves
HANGUP_WHEN_ALONE_AFTER=60

# --- Photo frame ---
SLIDESHOW_ENABLED=true
PHOTOS_DIR=/home/julienne/visio-tv/photos
SLIDESHOW_INTERVAL=8
SLIDESHOW_START=09:00
SLIDESHOW_END=21:00

# --- Ringtone ---
RINGTONE_ENABLED=true
RINGTONE_FILE=/home/julienne/visio-tv/ringtone.wav
RINGTONE_DURATION=45

# Volume step per +/- chat message
VOLUME_STEP=10
